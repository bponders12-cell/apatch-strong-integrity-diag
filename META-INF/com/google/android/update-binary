#!/sbin/sh
umask 022
ui_print() { echo "$1"; }
OUTFD=$2
ZIPFILE=$3
mount /data 2>/dev/null
[ -z "$MODPATH" ] && MODPATH="/data/adb/modules_update/apatch_strong_integrity_diag"
rm -rf "$MODPATH"
mkdir -p "$MODPATH"
unzip -o "$ZIPFILE" -x 'META-INF/*' -d "$MODPATH" >&2
if [ -f "$MODPATH/customize.sh" ]; then
  . "$MODPATH/customize.sh"
fi
exit 0
